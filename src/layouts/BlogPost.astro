---
import { Image } from 'astro:assets';
import { tabOf } from '../categories';
import CategoryTrail from '../components/CategoryTrail.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';
import TagList from '../components/TagList.astro';
import type { Post } from '../lib/posts';
import Page from './Page.astro';

type Props = Post['data'] & {
	// All posts in this post's tab, for the sidebar
	tabPosts: Post[];
};

const { title, description, pubDate, updatedDate, heroImage, category, tags, tabPosts } =
	Astro.props;
const tab = tabOf(category);
---

<Page
	title={title}
	description={description}
	image={heroImage}
	article={{ pubDate, updatedDate, tags }}
	sidebar={{ tab, currentCategory: category, tabPosts }}
>
	<article>
		{
			heroImage && (
				<div class="hero-image">
					<Image width={1020} height={510} src={heroImage} alt="" />
				</div>
			)
		}
		<div class="title">
			<CategoryTrail path={category} />
			<h1>{title}</h1>
			<div class="date">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span class="last-updated-on">
							· Updated <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</div>
			<TagList tab={tab} tags={tags} />
			<hr />
		</div>
		<div class="prose">
			<slot />
		</div>
		<Giscus />
	</article>
</Page>
<style>
	.hero-image img {
		display: block;
		width: 100%;
		height: auto;
		margin-bottom: 2em;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
	.title {
		margin-bottom: 1.5em;
	}
	.title h1 {
		margin: 0.2em 0 0.3em;
		line-height: 1.15;
	}
	.title :global(.tags) {
		justify-content: flex-start;
	}
	.date {
		color: rgb(var(--gray));
	}
	.last-updated-on {
		font-style: italic;
	}
	.prose {
		color: rgb(var(--gray-dark));
	}
</style>
