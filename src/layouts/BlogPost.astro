---
import { Image } from 'astro:assets';
import { tabOf } from '../categories';
import { SITE_DESCRIPTION } from '../consts';
import CategoryTrail from '../components/CategoryTrail.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';
import TagList from '../components/TagList.astro';
import type { Post } from '../lib/posts';
import Page from './Page.astro';

type Props = Post['data'];

const { title, description, pubDate, updatedDate, heroImage, category, tags } =
	Astro.props;
const tab = tabOf(category);
---

<Page
	title={title}
	description={description || SITE_DESCRIPTION}
	image={heroImage}
	article={{ pubDate, updatedDate, tags }}
	wide
>
	<article>
		{
			heroImage && (
				<div class="hero-image">
					<Image width={1020} height={510} src={heroImage} alt="" />
				</div>
			)
		}
		<header class="post-header">
			<CategoryTrail path={category} />
			<h1>{title}</h1>
			<div class="meta-grid">
				<div class="meta">
					<div>Published <FormattedDate date={pubDate} /></div>
					{
						updatedDate && (
							<div class="last-updated-on">
								Updated <FormattedDate date={updatedDate} />
							</div>
						)
					}
					<div data-view-count hidden>
						<span class="count"></span> views
					</div>
				</div>
				{description && <p class="lead">{description}</p>}
			</div>
		</header>
		<div class="prose">
			<slot />
		</div>
		{
			tags.length > 0 && (
				<footer class="post-tags">
					<TagList tab={tab} tags={tags} />
				</footer>
			)
		}
		<Giscus />
	</article>
</Page>
<style>
	.hero-image img {
		display: block;
		width: 100%;
		height: auto;
		margin-bottom: 2em;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
	.post-header {
		margin-bottom: 3em;
	}
	.post-header h1 {
		margin: 0.3em 0 0.6em;
		font-size: 2.6em;
		line-height: 1.1;
		letter-spacing: -0.01em;
	}
	/* Rule, then date/tags on the left and the summary as a lead on the right */
	.meta-grid {
		display: grid;
		grid-template-columns: 11em minmax(0, 1fr);
		gap: 2em;
		padding-top: 1.25em;
		border-top: 1px solid rgb(var(--black));
	}
	.meta {
		display: flex;
		flex-direction: column;
		gap: 0.2em;
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
	.last-updated-on {
		font-style: italic;
	}
	.lead {
		margin: 0;
		color: rgb(var(--black));
		font-size: 1.35em;
		line-height: 1.5;
	}
	@media (max-width: 720px) {
		.meta-grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 1em;
		}
	}

	.post-tags {
		margin-top: 2.5em;
		padding-top: 1.25em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.post-tags :global(.tags) {
		margin: 0;
	}

	/* Reading column: serif body, sans headings */
	.prose {
		color: rgb(var(--black));
		font-family: var(--font-serif);
		line-height: 1.55;
	}
	.prose :global(p) {
		margin: 0 0 1em;
	}
	.prose :global(:is(h2, h3, h4)) {
		margin: 2em 0 0.5em;
		font-family: var(--font-atkinson);
		font-weight: 700;
		line-height: 1.25;
	}
	.prose :global(h2) {
		font-size: 1.45em;
	}
	.prose :global(h3) {
		font-size: 1.2em;
	}
	.prose :global(h4) {
		font-size: 1em;
	}
	.prose :global(a) {
		color: inherit;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.15em;
	}
	.prose :global(a:hover) {
		color: var(--accent);
	}
	.prose :global(:is(ul, ol)) {
		margin: 0 0 1em;
		padding-left: 1.4em;
	}
	.prose :global(li) {
		margin-bottom: 0.5em;
	}
	.prose :global(:not(pre) > code) {
		padding: 0.05em 0.3em;
		border: 1px solid #e3ded0;
		border-radius: 4px;
		background: #f3f0e8;
		color: #b5573a;
		font-size: 0.9em;
	}
	.prose :global(pre) {
		margin: 0 0 1.5em;
		border: 1px solid #e3ded0;
		/* Override Shiki's inline white background */
		background-color: #f8f6f0 !important;
		font-size: 0.85em;
		line-height: 1.6;
	}
	.prose :global(blockquote) {
		margin: 0 0 1em;
		padding-left: 1em;
		border-left: 3px solid rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		font-size: 1em;
	}
	.prose :global(hr) {
		margin: 2em 0;
	}
</style>
