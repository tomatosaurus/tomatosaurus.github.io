---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import CategoryTrail from '../components/CategoryTrail.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';
import TagList from '../components/TagList.astro';
import Page from './Page.astro';

type Props = Pick<CollectionEntry<'blog'>['data'], 'title' | 'description' | 'heroImage'> &
	Partial<Pick<CollectionEntry<'blog'>['data'], 'pubDate' | 'updatedDate' | 'category' | 'tags'>> & {
		// Posts get article SEO metadata and comments; static pages like About don't
		isPost?: boolean;
	};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	tags = [],
	isPost = false,
} = Astro.props;
---

<Page
	title={title}
	description={description}
	image={heroImage}
	article={isPost && pubDate ? { pubDate, updatedDate, tags } : undefined}
	currentCategory={category}
>
	<article>
		{
			heroImage && (
				<div class="hero-image">
					<Image width={1020} height={510} src={heroImage} alt="" />
				</div>
			)
		}
		<div class="title">
			{category && <CategoryTrail path={category} />}
			<h1>{title}</h1>
			{
				isPost && pubDate && (
					<div class="date">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="last-updated-on">
								· Updated <FormattedDate date={updatedDate} />
							</span>
						)}
					</div>
				)
			}
			<TagList tags={tags} />
			<hr />
		</div>
		<div class="prose">
			<slot />
		</div>
		{isPost && <Giscus />}
	</article>
</Page>
<style>
	.hero-image img {
		display: block;
		width: 100%;
		height: auto;
		margin-bottom: 2em;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
	.title {
		margin-bottom: 1.5em;
	}
	.title h1 {
		margin: 0.2em 0 0.3em;
		line-height: 1.15;
	}
	.title :global(.tags) {
		justify-content: flex-start;
	}
	.date {
		color: rgb(var(--gray));
	}
	.last-updated-on {
		font-style: italic;
	}
	.prose {
		color: rgb(var(--gray-dark));
	}
</style>
