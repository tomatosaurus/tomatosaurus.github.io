---
import type { ComponentProps } from 'astro/types';
import BaseHead from '../components/BaseHead.astro';
import CategoryNav from '../components/CategoryNav.astro';
import Footer from '../components/Footer.astro';
import ViewCounter from '../components/ViewCounter.astro';
import Header from '../components/Header.astro';
import TagFilter from '../components/TagFilter.astro';
import type { Post } from '../lib/posts';

type Props = ComponentProps<typeof BaseHead> & {
	// Tab pages and posts get a sidebar with the tab's categories and tag filter
	sidebar?: {
		tab: string;
		currentCategory?: string;
		tabPosts: Post[];
		// Posts the tag filter counts over; defaults to the whole tab
		scopePosts?: Post[];
	};
};

const { sidebar, ...head } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead {...head} />
	</head>
	<body>
		<Header />
		<slot name="below-header" />
		<div class:list={['container', 'layout', { 'has-sidebar': sidebar }]}>
			<main>
				<slot />
			</main>
			{
				sidebar && (
					<aside>
						<CategoryNav
							tab={sidebar.tab}
							current={sidebar.currentCategory}
							posts={sidebar.tabPosts}
						/>
						<TagFilter tab={sidebar.tab} posts={sidebar.scopePosts ?? sidebar.tabPosts} />
					</aside>
				)
			}
		</div>
		<Footer />
		<ViewCounter />
	</body>
</html>
<style>
	.layout {
		padding-block: 3em;
	}
	.layout main {
		width: auto;
		max-width: 720px;
		margin: 0;
		padding: 0;
		/* Content text is smaller than the header, footer and sidebar */
		font-size: 0.85em;
	}
	.has-sidebar {
		display: grid;
		grid-template-columns: 220px minmax(0, 1fr);
		grid-template-areas: 'aside main';
		gap: 3em;
	}
	.has-sidebar main {
		grid-area: main;
	}
	aside {
		grid-area: aside;
		display: flex;
		flex-direction: column;
		gap: 2em;
		position: sticky;
		top: 1.5em;
		align-self: start;
	}
	aside :global(h2) {
		margin: 0 0 0.6em;
		color: rgb(var(--gray));
		font-size: 0.75em;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	/* Narrow screens: sidebar drops below the content */
	@media (max-width: 960px) {
		.has-sidebar {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas: 'main' 'aside';
			gap: 2em;
		}
		aside {
			position: static;
			padding-top: 1.5em;
			border-top: 1px solid rgb(var(--gray-light));
		}
	}
	@media (max-width: 720px) {
		.layout {
			padding-block: 2em;
		}
	}
</style>
