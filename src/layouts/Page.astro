---
import type { ComponentProps } from 'astro/types';
import BaseHead from '../components/BaseHead.astro';
import CategoryNav from '../components/CategoryNav.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

type Props = ComponentProps<typeof BaseHead> & {
	// Category to highlight in the sidebar
	currentCategory?: string;
};

const { currentCategory, ...head } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead {...head} />
	</head>
	<body>
		<Header />
		<div class="layout">
			<main>
				<slot />
			</main>
			<aside>
				<CategoryNav current={currentCategory} />
			</aside>
		</div>
		<Footer />
	</body>
</html>
<style>
	.layout {
		display: grid;
		grid-template-columns: 220px minmax(0, 720px);
		grid-template-areas: 'aside main';
		justify-content: center;
		gap: 3em;
		padding: 3em 1em;
	}
	.layout main {
		grid-area: main;
		width: auto;
		max-width: none;
		margin: 0;
		padding: 0;
	}
	aside {
		grid-area: aside;
		position: sticky;
		top: 1.5em;
		align-self: start;
	}
	/* Narrow screens: categories drop below the content */
	@media (max-width: 960px) {
		.layout {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas: 'main' 'aside';
			gap: 2em;
			padding: 2em 1em;
		}
		aside {
			position: static;
			padding-top: 1.5em;
			border-top: 1px solid rgb(var(--gray-light));
		}
	}
</style>
