---
// Total and today's visitor counts; filled in by ViewCounter.
---

<div class="site-stats container">
	<span data-view-count="TOTAL" hidden>
		<span class="count"></span> total visitors
	</span>
	<span data-view-count="TOTAL" data-view-since="today" hidden>
		· <span class="count"></span> today
	</span>
</div>
<style>
	.site-stats {
		display: flex;
		gap: 0.4em;
		padding-top: 0.75em;
		color: rgb(var(--gray));
		font-size: 0.85em;
	}
	.site-stats [hidden] {
		display: none;
	}
</style>
