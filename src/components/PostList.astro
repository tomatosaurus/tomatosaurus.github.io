---
import { tabOf } from '../categories';
import { type Post, postUrl, tagSlug } from '../lib/posts';
import CategoryTrail from './CategoryTrail.astro';
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="post-list" data-post-list>
	{
		posts.map((post) => (
			<li data-tags={post.data.tags.map(tagSlug).join(' ')}>
				<div class="meta">
					<CategoryTrail path={post.data.category} />
					<span>·</span>
					<FormattedDate date={post.data.pubDate} />
					<span data-view-count={postUrl(post)} hidden>
						· <span class="count" /> views
					</span>
					{post.data.draft && <span class="draft">draft</span>}
				</div>
				<h3>
					<a href={postUrl(post)}>{post.data.title}</a>
				</h3>
				{post.data.description && <p class="description">{post.data.description}</p>}
				<TagList tab={tabOf(post.data.category)} tags={post.data.tags} />
			</li>
		))
	}
</ul>
{posts.length === 0 && <p class="empty">No posts yet.</p>}
<p class="empty" data-filter-empty hidden>No posts match the selected tags.</p>
<style>
	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		padding: 1.5em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	li:first-child {
		padding-top: 0;
	}
	h3 {
		margin: 0.2em 0;
		font-size: 1.5em;
	}
	h3 a {
		color: rgb(var(--black));
		text-decoration: none;
	}
	h3 a:hover {
		color: var(--accent);
	}
	.meta,
	.description,
	.empty {
		margin: 0;
		color: rgb(var(--gray));
	}
	.meta {
		display: flex;
		align-items: baseline;
		gap: 0.5em;
		font-size: 0.9em;
	}
	.draft {
		padding: 0 0.4em;
		border-radius: 4px;
		background: #fde68a;
		color: #78350f;
	}
	.empty[hidden] {
		display: none;
	}
</style>
