---
import { CATEGORY_LIST, categoryUrl, inCategory } from '../categories';
import type { Post } from '../lib/posts';

interface Props {
	tab: string;
	// Category path of the current page/post, used for highlighting
	current?: string;
	// All posts in this tab
	posts: Post[];
}

const { tab, current, posts } = Astro.props;
const categories = CATEGORY_LIST.filter((c) => c.depth > 0 && inCategory(c.path, tab));
const count = (path: string) => posts.filter((p) => inCategory(p.data.category, path)).length;
---

<nav class="category-nav" aria-label="Categories">
	<h2>Categories</h2>
	<ul>
		<li>
			<a href={categoryUrl(tab)} class:list={{ active: current === tab }}>
				All <span class="count">{posts.length}</span>
			</a>
		</li>
		{
			categories.map((c) => (
				<li style={`--depth: ${c.depth - 1}`}>
					<a
						href={categoryUrl(c.path)}
						class:list={{
							active: current === c.path,
							open: current !== undefined && current !== c.path && inCategory(current, c.path),
						}}
					>
						{c.label} <span class="count">{count(c.path)}</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>
<style>
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		padding-left: calc(var(--depth, 0) * 1em);
	}
	a {
		display: flex;
		justify-content: space-between;
		gap: 0.75em;
		padding: 0.25em 0.5em;
		border-radius: 6px;
		color: rgb(var(--gray-dark));
		font-size: 0.95em;
		text-decoration: none;
	}
	a:hover,
	a.open {
		color: var(--accent);
	}
	a.active {
		background: color-mix(in srgb, var(--accent) 10%, transparent);
		color: var(--accent);
	}
	.count {
		color: rgb(var(--gray));
	}
</style>
