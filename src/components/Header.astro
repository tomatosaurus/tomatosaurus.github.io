---
import { CATEGORIES } from '../categories';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav class="container">
		<a class="site-title" href="/">{SITE_TITLE}</a>
		<div class="tabs">
			{CATEGORIES.map((tab) => <HeaderLink href={`/${tab.slug}/`}>{tab.label}</HeaderLink>)}
			<HeaderLink href="/contact/">Contact</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	.site-title {
		padding: 1em 0;
		color: rgb(var(--black));
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
	}
	.tabs {
		display: flex;
		gap: 1.25em;
	}
	.tabs :global(a) {
		padding: 1.1em 0;
		border-bottom: 3px solid transparent;
		color: rgb(var(--gray-dark));
		font-size: 0.8em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}
	.tabs :global(a:hover) {
		color: var(--accent);
	}
	.tabs :global(a.active) {
		border-bottom-color: var(--accent);
		color: var(--accent);
	}
	@media (max-width: 480px) {
		.tabs {
			gap: 0.9em;
		}
	}
</style>
