---
import { CATEGORIES } from '../categories';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav class="container">
		<a class="site-title" href="/">{SITE_TITLE}</a>
		<button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-tabs">
			<span></span><span></span><span></span>
		</button>
		<div class="tabs" id="site-tabs">
			{CATEGORIES.map((tab) => <HeaderLink href={`/${tab.slug}/`}>{tab.label}</HeaderLink>)}
			<HeaderLink href="/contact/">Contact</HeaderLink>
			<!-- GitHub sign-in for Giscus comments; href and label are set by the script below -->
			<a class="login" href="https://giscus.app/api/oauth/authorize" data-giscus-login>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="14" height="14"
					><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg
				>
				<span data-label>Login</span>
			</a>
		</div>
	</nav>
</header>
<script>
	// Site-wide GitHub sign-in that reuses Giscus's OAuth flow: GitHub sends the visitor back
	// with ?giscus=<session>, which Giscus reads from localStorage on every comment widget.
	// Giscus's client.js does this too, but only on pages that have comments.
	const KEY = 'giscus-session';
	const url = new URL(location.href);
	const session = url.searchParams.get('giscus');
	if (session) {
		localStorage.setItem(KEY, JSON.stringify(session));
		url.searchParams.delete('giscus');
		history.replaceState(history.state, '', url);
	}

	// Mobile hamburger: toggles the tab list open/closed
	const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	const tabs = document.getElementById('site-tabs');
	if (toggle && tabs) {
		const setOpen = (open: boolean) => {
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			tabs.classList.toggle('open', open);
		};
		toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') setOpen(false);
		});
		document.addEventListener('click', (e) => {
			if (!(e.target as Element).closest('header')) setOpen(false);
		});
	}

	const link = document.querySelector<HTMLAnchorElement>('[data-giscus-login]');
	if (link) {
		if (localStorage.getItem(KEY)) {
			link.querySelector('[data-label]')!.textContent = 'Logout';
			link.href = '#';
			link.addEventListener('click', (e) => {
				e.preventDefault();
				localStorage.removeItem(KEY);
				location.reload();
			});
		} else {
			url.hash = '';
			link.href = `https://giscus.app/api/oauth/authorize?redirect_uri=${encodeURIComponent(url.href)}`;
		}
	}
</script>
<style>
	header {
		position: relative;
		z-index: 10;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	.site-title {
		padding: 1em 0;
		color: rgb(var(--black));
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
	}
	.tabs {
		display: flex;
		gap: 1.25em;
	}
	.tabs :global(a) {
		padding: 1.1em 0;
		border-bottom: 3px solid transparent;
		color: rgb(var(--gray-dark));
		font-size: 0.8em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}
	.tabs :global(a:hover) {
		color: var(--accent);
	}
	.tabs .login {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		align-self: center;
		padding: 0.35em 0.9em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
	}
	.tabs .login:hover {
		border-color: var(--accent);
	}
	.tabs :global(a.active) {
		border-bottom-color: var(--accent);
		color: var(--accent);
	}
	.menu-toggle {
		display: none;
	}
	@media (max-width: 640px) {
		.menu-toggle {
			display: inline-flex;
			flex-direction: column;
			justify-content: center;
			gap: 5px;
			width: 40px;
			height: 40px;
			padding: 0 9px;
			border: 0;
			background: none;
			cursor: pointer;
		}
		.menu-toggle span {
			display: block;
			height: 2px;
			border-radius: 2px;
			background: rgb(var(--black));
			transition: transform 0.2s ease, opacity 0.2s ease;
		}
		.menu-toggle[aria-expanded='true'] span:nth-child(1) {
			transform: translateY(7px) rotate(45deg);
		}
		.menu-toggle[aria-expanded='true'] span:nth-child(2) {
			opacity: 0;
		}
		.menu-toggle[aria-expanded='true'] span:nth-child(3) {
			transform: translateY(-7px) rotate(-45deg);
		}
		.tabs {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			gap: 0;
			padding: 0.5em 0 1em;
			padding-inline: inherit; /* line up with the site title */
			background: white;
			box-shadow: 0 8px 12px rgba(var(--black), 8%);
		}
		.tabs.open {
			display: flex;
		}
		.tabs :global(a) {
			padding: 0.9em 0;
			border-bottom: 1px solid rgb(var(--gray-light));
		}
		.tabs :global(a.active) {
			border-bottom-color: rgb(var(--gray-light));
			text-decoration: none;
		}
		.tabs .login {
			align-self: flex-start;
			margin-top: 0.9em;
		}
	}
</style>
