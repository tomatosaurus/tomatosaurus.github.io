---
import Layout from '../layouts/BlogPost.astro';
import { AUTHOR_DEVTO, AUTHOR_GITHUB, AUTHOR_NAME } from '../consts';
---

<Layout
	title="About"
	description={`About ${AUTHOR_NAME}.`}
	pubDate={new Date('2026-09-30')}
>
	<p>
		Hi, I'm {AUTHOR_NAME}. I write about production troubleshooting, machine learning systems and
		cloud infrastructure architecture — the long-tail errors and design decisions that don't have
		good answers elsewhere yet.
	</p>
	<ul>
		<li><a href={AUTHOR_GITHUB}>GitHub</a></li>
		<li><a href={AUTHOR_DEVTO}>DEV Community</a></li>
		<li><a href="/rss.xml">RSS feed</a></li>
	</ul>
</Layout>
