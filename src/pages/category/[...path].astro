---
import { CATEGORY_LIST, type FlatCategory, inCategory } from '../../categories';
import CategoryTrail from '../../components/CategoryTrail.astro';
import PostList from '../../components/PostList.astro';
import Page from '../../layouts/Page.astro';
import { getPosts } from '../../lib/posts';

export function getStaticPaths() {
	// Every defined category gets a page, even before it has posts
	return CATEGORY_LIST.map((category) => ({ params: { path: category.path }, props: { category } }));
}

const { category } = Astro.props as { category: FlatCategory };
const posts = (await getPosts()).filter((p) => inCategory(p.data.category, category.path));
---

<Page
	title={category.trail.map((c) => c.label).join(' / ')}
	description={`Posts in ${category.label}.`}
	currentCategory={category.path}
>
	{category.depth > 0 && <CategoryTrail path={category.path} />}
	<h1>{category.label}</h1>
	<PostList posts={posts} />
</Page>
