---
import type { CollectionEntry } from 'astro:content';
import PostList from '../../components/PostList.astro';
import Page from '../../layouts/Page.astro';
import { getPosts, tagSlug } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	const byTag = new Map<string, { name: string; posts: CollectionEntry<'blog'>[] }>();
	for (const post of posts) {
		for (const name of post.data.tags) {
			const slug = tagSlug(name);
			if (!byTag.has(slug)) byTag.set(slug, { name, posts: [] });
			byTag.get(slug)!.posts.push(post);
		}
	}
	return [...byTag].map(([tag, props]) => ({ params: { tag }, props }));
}

const { name, posts } = Astro.props;
---

<Page title={`#${name}`} description={`Posts tagged "${name}".`}>
	<p><a href="/tags/">← All tags</a></p>
	<h1>#{name}</h1>
	<PostList posts={posts} />
</Page>
