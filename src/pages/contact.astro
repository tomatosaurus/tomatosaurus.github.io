---
import { AUTHOR_GITHUB, AUTHOR_LINKEDIN } from '../consts';
import Page from '../layouts/Page.astro';

// Every section renders as the same timeline: a bold name (with an optional period),
// then gray lines that can each carry their own period, then optional writers.
type Line = { text: string; period?: string };
type Entry = { name: string; period?: string; lines: Line[]; writers?: string[] };

const ME = 'Jonghun Park';

const experience: Entry[] = [
	{
		name: 'Google Singapore',
		lines: [{ text: 'Forward Deployed Engineer | Google Cloud JPAC AI Tech GTM', period: 'Oct 2026 – Present' }],
	},
	{
		name: 'NAVER',
		lines: [
			{ text: 'Tech Leader & AI/ML Engineer | Product Data AI', period: 'Feb 2025 – 2026' },
			{ text: 'AI/ML Engineer | Product Data AI', period: 'Mar 2020 – Feb 2025' },
		],
	},
	{
		name: 'Bongjiks',
		lines: [{ text: 'Co-Founder', period: 'Nov 2025 – Present' }],
	},
];

const education: Entry[] = [
	{ name: 'KAIST', period: '2018 – 2020', lines: [{ text: 'M.S. Electrical Engineering · Quantum algorithms & quantum computing' }] },
	{ name: 'KAIST', period: '2014 – 2018', lines: [{ text: 'B.S. Electrical Engineering' }] },
];

const publications: Entry[] = [
	{
		name: 'E-CLIP: Large-scale Vision-Language Representation Learning in E-commerce',
		period: '2022',
		lines: [{ text: 'CIKM' }],
		writers: ['Wonyoung Shin', ME, 'Taekang Woo', 'Yongwoo Cho', 'Kwangjin Oh', 'Hwanjun Song'],
	},
	{
		name: 'Quantum-classical reinforcement learning for decoding noisy classical parity information',
		period: '2020',
		lines: [{ text: 'Quantum Machine Intelligence' }],
		writers: ['Daniel K. Park', ME, 'June-Koo Kevin Rhee'],
	},
	{
		name: 'Quantum-classical reinforcement algorithm for learning parity with noisy classical data and a noisy quantum machine',
		period: '2019',
		lines: [{ text: 'QTML' }],
	},
	{
		name: 'Quantum-classical reinforcement parity learning from noisy classical data',
		period: '2019',
		lines: [{ text: 'APS March Meeting' }],
		writers: ['Daniel K. Park', ME, 'Suhwang Jeong', 'Jeongseok Ha', 'June-Koo Kevin Rhee'],
	},
];

const patents: Entry[] = [
	{
		name: 'Quantum algorithm and circuit for learning parity with noise of classical learning data',
		period: '2019',
		lines: [{ text: 'KR 10-2019-0174220' }],
	},
];

const sections = [
	{ heading: 'Experience', entries: experience },
	{ heading: 'Education', entries: education },
	{ heading: 'Publications', entries: publications },
	{ heading: 'Patents', entries: patents },
];
---

<Page title="Contact" description="Jonghun Park — Forward Deployed Engineer at Google. Career, research and how to reach me.">
	<h1>Contact</h1>
	<p class="lead">
		Hi, I'm <strong>Jonghun Park</strong>, a Forward Deployed Engineer at Google Singapore. Before
		that I spent six years at NAVER building commerce-scale ML — from pre-training multimodal
		foundation models to leading teams that ship LLM-based catalog services. I started out in
		quantum algorithms at KAIST. This blog is where I study and solve real-world problems.
	</p>
	<ul class="links">
		<li><a href={AUTHOR_LINKEDIN}>LinkedIn</a></li>
		<li><a href={AUTHOR_GITHUB}>GitHub</a></li>
	</ul>

	{
		sections.map(({ heading, entries }) => (
			<>
				<h2>{heading}</h2>
				<ol class="timeline">
					{entries.map((e) => (
						<li>
							<div class="row">
								<strong>{e.name}</strong>
								{e.period && <span class="period">{e.period}</span>}
							</div>
							{e.lines.map((l) => (
								<div class="row detail">
									<span>{l.text}</span>
									{l.period && <span class="period">{l.period}</span>}
								</div>
							))}
							{e.writers && (
								<div class="writers">
									{e.writers.map((w, i) => (
										<>
											{i > 0 && ', '}
											{w === ME ? <strong>{w}</strong> : w}
										</>
									))}
								</div>
							)}
						</li>
					))}
				</ol>
			</>
		))
	}
</Page>
<style>
	.lead {
		font-size: 1.1em;
	}
	.links {
		display: flex;
		gap: 1.25em;
		padding: 0;
		list-style: none;
	}
	h2 {
		margin-top: 1.75em;
		font-size: 1.5em;
	}
	.timeline {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.timeline > li {
		padding: 0.75em 0 0.75em 1em;
		border-left: 2px solid rgb(var(--gray-light));
	}
	/* Long titles wrap on their own; the period stays on the first line */
	.row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1em;
	}
	.period,
	.detail,
	.writers {
		color: rgb(var(--gray));
	}
	.writers {
		font-size: 0.9em;
	}
	.period {
		font-size: 0.9em;
		white-space: nowrap;
	}
</style>
